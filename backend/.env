FLASK_ENV=production
FLASK_DEBUG=False

# MySQL will run on port 3307 externally, but internal Docker communication uses 3306
DATABASE_URL=mysql+pymysql://app_user:secure_app_password@mysql:3306/image_search_db
MYSQL_ROOT_PASSWORD=secure_root_password
MYSQL_DATABASE=image_search_db
MYSQL_USER=app_user
MYSQL_PASSWORD=secure_app_password

REDIS_URL=redis://redis:6379/0
RATE_LIMIT_STORAGE_URL=redis://redis:6379/2

CELERY_BROKER_URL=pyamqp://guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

RABBITMQ_USER=admin
RABBITMQ_PASSWORD=secure_rabbit_password

JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

FRONTEND_URL=http://localhost:3000

VECTOR_DB_TYPE=chromadb
CHROMADB_PATH=./chroma_db
PINECONE_API_KEY=optional-if-using-pinecone
PINECONE_ENVIRONMENT=optional-if-using-pinecone

MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=static/uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

RATE_LIMIT_DEFAULT=1000 per hour
RATE_LIMIT_AUTH=10 per minute
RATE_LIMIT_UPLOAD=20 per hour

LOG_LEVEL=INFO
LOG_FILE=logs/app.log
AUDIT_LOG_FILE=logs/audit.log

ENABLE_METRICS=True
METRICS_PORT=9090