FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y \
    python3.11 \
    python3.11-dev \
    python3-pip \
    python3.11-venv \
    build-essential \
    cmake \
    pkg-config \
    libmysqlclient-dev \
    libhdf5-dev \
    libopencv-dev \
    libgtk-3-dev \
    libboost-all-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1-mesa-glx \
    libssl-dev \
    wget \
    curl \
    git \
    netcat \
    cargo \
    rustc \
    && rm -rf /var/lib/apt/lists/*

# Install an up-to-date Rust toolchain (needed for building tokenizers wheels)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --profile minimal --default-toolchain 1.80.1
ENV PATH="/root/.cargo/bin:${PATH}"

# Install newer SQLite for ChromaDB compatibility (requires 3.35.0+)
RUN wget https://www.sqlite.org/2023/sqlite-autoconf-3420000.tar.gz && \
    tar -xzf sqlite-autoconf-3420000.tar.gz && \
    cd sqlite-autoconf-3420000 && \
    ./configure --prefix=/usr/local && \
    make && make install && \
    cd .. && rm -rf sqlite-autoconf-3420000* && \
    echo "/usr/local/lib" > /etc/ld.so.conf.d/sqlite3.conf && \
    ldconfig

RUN useradd --create-home --shell /bin/bash app
WORKDIR /app

# Install UV from official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /bin/uv

# Set UV environment variables for optimal Docker performance
ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/usr/local \
    RUSTFLAGS="-A invalid_reference_casting"

COPY requirements-minimal.txt .

# Install PyTorch CPU versions first with UV pip for better compatibility
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --python python3.11 torch torchvision --index-url https://download.pytorch.org/whl/cpu

# Install remaining packages from requirements file with cache mount
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --python python3.11 -r requirements-minimal.txt

COPY --chown=app:app . .

RUN mkdir -p static/uploads/{images,thumbnails,faces} logs chroma_db && \
    chown -R app:app static logs chroma_db

# Create model cache directories with proper permissions
RUN mkdir -p /home/app/.cache /home/app/.deepface && \
    chown -R app:app /home/app/.cache /home/app/.deepface

# Optional: Download spacy model (comment out if internet is slow)
# RUN python3.11 -m spacy download en_core_web_sm

# Copy and set up entrypoint script  
COPY entrypoint-simple.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER app

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

EXPOSE 8080

ENTRYPOINT ["/entrypoint.sh"]
