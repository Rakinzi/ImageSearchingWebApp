FROM python:3.9-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    pkg-config \
    default-libmysqlclient-dev \
    libhdf5-dev \
    libopencv-dev \
    libgtk-3-dev \
    libboost-all-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1-mesa-glx \
    wget \
    curl \
    git \
    netcat-openbsd \
    && rm -rf /var/lib/apt/lists/*

# Create app user
RUN useradd --create-home --shell /bin/bash app

WORKDIR /app

# Install PyTorch first with the correct index
RUN pip install --upgrade pip setuptools wheel
RUN pip install torch==2.1.2 torchvision==0.16.2 --index-url https://download.pytorch.org/whl/cpu

# Copy and install other requirements
COPY requirements-cpu-fixed.txt .
RUN pip install --no-cache-dir -r requirements-cpu-fixed.txt

# Copy application code
COPY --chown=app:app . .

# Create directories and set permissions
RUN mkdir -p static/uploads/{images,thumbnails,faces} logs chroma_db && \
    chown -R app:app static logs chroma_db

# Download required models (with error handling)
RUN python -c "import spacy; spacy.cli.download('en_core_web_sm')" || echo "spaCy model download failed, will try at runtime"
RUN python -c "import nltk; nltk.download('punkt', quiet=True); nltk.download('stopwords', quiet=True); nltk.download('words', quiet=True)" || echo "NLTK download failed, will try at runtime"

USER app

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:5000/health || exit 1

EXPOSE 5000

# Create a simple entrypoint script
COPY --chown=app:app entrypoint-simple.sh /entrypoint.sh
USER root
RUN chmod +x /entrypoint.sh
USER app

ENTRYPOINT ["/entrypoint.sh"]