# Image Search Web Application - Environment Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# APPLICATION ENVIRONMENT
# =============================================================================
FLASK_ENV=production
FLASK_DEBUG=False
TIMEZONE=Africa/Harare

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=image_search_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_app_password
DATABASE_URL=postgresql://app_user:secure_app_password@postgresql:5432/image_search_db

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_STORAGE_URL=redis://redis:6379/2

# =============================================================================
# MESSAGE BROKER CONFIGURATION (RabbitMQ)
# =============================================================================
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=secure_rabbit_password
CELERY_BROKER_URL=pyamqp://admin:secure_rabbit_password@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# IMPORTANT: Change this to a strong random secret key in production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000
JWT_COOKIE_HTTPONLY=true
JWT_COOKIE_SECURE=false
JWT_COOKIE_SAMESITE=Lax
JWT_COOKIE_CSRF_PROTECT=false

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-specific-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# =============================================================================
# FRONTEND CONFIGURATION
# =============================================================================
# FRONTEND_URL: Used for email links (verification, password reset)
#   - Docker production: http://localhost (frontend on port 80)
#   - Local development: http://localhost:5173 (Vite dev server)
# VITE_API_URL: API endpoint for frontend to call
#   - Always: http://localhost:8080 (backend port)
FRONTEND_URL=http://localhost
VITE_API_URL=http://localhost:8080

# =============================================================================
# CORS CONFIGURATION
# =============================================================================
# Allow requests from both production (port 80) and development (port 5173)
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:8080

# =============================================================================
# VECTOR DATABASE CONFIGURATION
# =============================================================================
VECTOR_DB_TYPE=pgvector
CHROMADB_PATH=./chroma_db
PINECONE_API_KEY=optional-if-using-pinecone
PINECONE_ENVIRONMENT=optional-if-using-pinecone

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=static/uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,webp

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
RATE_LIMIT_DEFAULT=1000 per hour
RATE_LIMIT_AUTH=10 per minute
RATE_LIMIT_UPLOAD=20 per hour

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
AUDIT_LOG_FILE=logs/audit.log

# =============================================================================
# METRICS CONFIGURATION
# =============================================================================
ENABLE_METRICS=True
METRICS_PORT=9090

# =============================================================================
# NOTES
# =============================================================================
# - All default values work for testing on Mac/Linux with Docker
# - For production, change all passwords and secret keys
# - Database and Redis URLs are automatically configured in docker-compose.yml
# - Frontend proxies API requests through nginx, no separate frontend env needed
